# Generic FFB effect settings

# set the global strength of all effects here (default is 100)
GLOBAL_GAIN 100

# set the strength during intialization phase if required
INITIALIZATION_GAIN 100

# for the games not supporting FFB effects, you can set a generic auto center effect here (default is 0)
AUTO_CENTER 1

# adjust spring effect if necessary here (default is 0-100)
MIN_SPRING 15
MAX_SPRING 100

# adjust friction effect if necessary here (default is 0-100)
MIN_FRICTION 15
MAX_FRICTION 100

# adjust torque effect if necessary here (default is 0-100)
MIN_TORQUE 15
MAX_TORQUE 100

# adjust sine effect intensity if necessary here (default is 0-100)
MIN_INTENSITY 15
MAX_INTENSITY 100

# for those who want to use a Logitech racing wheel which is supported by new-lg4ff
# it is possible to set steering range up to 900 degree (i.e. G25, G27),
LOGITECH_STEERING_RANGE 360

